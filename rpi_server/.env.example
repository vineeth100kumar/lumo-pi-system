# LUMO Server Environment Configuration Template
# Copy this file to .env and fill in your keys

# Ports & Network
WS_PORT=8765
HTTP_PORT=8080
MDNS_NAME=lumo

# JARVIS Voice Assistant (Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here
VOICE_ENABLED=true
VOICE_INPUT_DEVICE=default
VOICE_NAME=en-GB-RyanNeural

# Spotify (Optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Weather Coordinates (Default: Bangalore)
WEATHER_LAT=13.003648
WEATHER_LON=77.628993

# Sage task manager (shared tasks, reminders and alarms)
# Lumo reads and writes them through Sage's API instead of keeping its own
# lists. On the Pi the key comes from /etc/sage/sage.env via systemd, so leave
# SAGE_API_KEY empty there; set it only when running main.py by hand.
SAGE_API_URL=http://127.0.0.1:8000
SAGE_API_KEY=
